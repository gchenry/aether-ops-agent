FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN useradd -m -u 8888 aether && chown -R aether:aether /app
COPY --chown=aether:aether app/ app/

USER aether

EXPOSE 8081

# 🚀 Dynamic port binding using the $PORT environment variable
CMD ["sh", "-c", "uvicorn app.deployer:app --host 0.0.0.0 --port ${PORT:-8081}"]
